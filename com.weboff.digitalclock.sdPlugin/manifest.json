{
  "Name": "Digital Clock by Weboff",
  "Version": "0.2.0",
  "Description": "A local digital clock with a configurable application shortcut.",
  "Author": "Weboff",
  "SDKVersion": 1,
  "Icon": "images/icon.png",
  "Category": "Digital Clock",
  "CategoryIcon": "images/category.png",
  "CodePath": "src/plugin.js",
  "CodePathMac": "src/plugin.js",
  "Nodejs": {
    "Version": "20"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13.0"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Software": {
    "MinimumVersion": "2.10.179.426"
  },
  "Actions": [
    {
      "UUID": "com.weboff.digitalclock.clock",
      "Name": "Digital Clock",
      "Tooltip": "Show local time and date. Press to open this key\u2019s selected application.",
      "Icon": "images/action.png",
      "PropertyInspectorPath": "property-inspector/index.html",
      "Controllers": [
        "Keypad",
        "Knob"
      ],
      "States": [
        {
          "Image": "images/idle.png",
          "ShowTitle": false
        }
      ],
      "DisableAutomaticStates": true,
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false
    }
  ],
  "CodePathWin": "src/plugin.js"
}
